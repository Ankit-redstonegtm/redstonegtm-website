# Public site origin used for canonical URLs, Open Graph, sitemap, and JSON-LD.
# No trailing slash. Rebuild after changing it.
PUBLIC_SITE_URL=https://redstonegtm.com

# Every "Book a call" button uses this URL. Replace with the real Cal.com or Calendly link.
PUBLIC_BOOKING_URL=https://cal.com/redstone-gtm/discovery

# Optional. When set, an inline scheduler iframe renders under the final call to action.
# Example: https://cal.com/redstone-gtm/discovery?embed=true
PUBLIC_BOOKING_EMBED_URL=

# Lead-magnet form POST target. Defaults to the built-in stub at /api/lead.
# Point this at Attio, an email tool, or another endpoint when one exists.
# The stub expects JSON: { name, email, resource } and returns { ok, assetUrl, assetLabel }.
PUBLIC_LEAD_FORM_ENDPOINT=/api/lead
