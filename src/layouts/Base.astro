---
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/newsreader/latin-500.css';
import newsreaderWoff from '@fontsource/newsreader/files/newsreader-latin-500-normal.woff2?url';
import interWoff from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { organizationJsonLd, serializeJsonLd } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  image?: string;
  robots?: string;
  jsonLd?: unknown[];
}

const { title, description, image = '/og.png', robots, jsonLd = [] } = Astro.props;
const origin = Astro.site ?? site.url;
const canonical = new URL(Astro.url.pathname, origin).href;
const imageUrl = new URL(image, origin).href;
const imageAlt = `${site.name}. Fractional GTM engineering for sales-led vertical SaaS.`;
const graphs = [organizationJsonLd(), ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="author" content={site.founder.name} />
    <meta name="theme-color" content="#FBF9F5" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={newsreaderWoff} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interWoff} as="font" type="font/woff2" crossorigin="anonymous" />

    <Fragment set:html={graphs.map((graph) => `<script type="application/ld+json">${serializeJsonLd(graph)}</script>`).join('')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
