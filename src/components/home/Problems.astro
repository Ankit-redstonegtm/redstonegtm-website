---
import { home } from '../../data/home';

const { problems } = home;
---

<section class="section band" id="problems" aria-labelledby="problems-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{problems.eyebrow}</p>
      <h2 id="problems-title">{problems.title}</h2>
      <p class="lede">{problems.lede}</p>
    </div>
    <ol class="problem-list">
      {problems.items.map((item) => <li>{item}</li>)}
    </ol>
  </div>
</section>
