---
import { Image } from 'astro:assets';
import founder from '../../assets/founder.png';
import Em from '../Em.astro';
import { home } from '../../data/home';
import { site } from '../../data/site';

const { about } = home;
const featured = about.recommendations.find((item) => item.featured);
const rest = about.recommendations.filter((item) => !item.featured);
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about-top">
      <figure class="about-photo">
        <Image
          src={founder}
          alt={about.photoAlt}
          width={304}
          height={380}
          densities={[1, 2]}
          sizes="(min-width: 900px) 320px, 86vw"
          quality={90}
          loading="eager"
          decoding="sync"
          class="portrait"
        />
        <ul class="facts">
          {about.facts.map((fact) => <li>{fact}</li>)}
        </ul>
        <figcaption>{about.factsNote}</figcaption>
      </figure>
      <div class="about-copy">
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 id="about-title">{about.title}</h2>
        {about.paragraphs.map((paragraph) => (
          <p>
            <Em text={paragraph} />
          </p>
        ))}
      </div>
    </div>

    <div class="recs">
      <h3>{about.recsTitle}</h3>
      <p class="lede">{about.recsSubhead}</p>
      {
        featured && (
          <blockquote class="rec rec-featured">
            <footer class="rec-who">
              <p class="rec-name">{featured.name}</p>
              <p class="rec-role">{featured.title}</p>
              <p class="rec-tag">{featured.tag}</p>
            </footer>
            <p class="rec-quote">{featured.quote}</p>
          </blockquote>
        )
      }
      <div class="rec-row">
        {
          rest.map((item) => (
            <blockquote class="rec">
              <footer class="rec-who">
                <p class="rec-name">{item.name}</p>
                <p class="rec-role">{item.title}</p>
                <p class="rec-tag">{item.tag}</p>
              </footer>
              <p class="rec-quote">{item.quote}</p>
            </blockquote>
          ))
        }
      </div>
      <p class="recs-link">
        <a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">
          {about.recsLink}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </p>
    </div>
  </div>
</section>
