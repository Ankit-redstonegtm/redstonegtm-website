---
import { home } from '../../data/home';

const { situations } = home;
---

<section class="section" id="situations" aria-labelledby="situations-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{situations.eyebrow}</p>
      <h2 id="situations-title">{situations.title}</h2>
      <p class="lede">{situations.lede}</p>
    </div>
    <ul class="situation-list">
      {situations.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>
