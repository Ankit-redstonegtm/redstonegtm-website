---
import Button from '../Button.astro';
import { home } from '../../data/home';
import { bookingCta, site } from '../../data/site';

const { ownership } = home;
---

<section class="section" id="what-i-own" aria-labelledby="ownership-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{ownership.eyebrow}</p>
      <h2 id="ownership-title">{ownership.title}</h2>
      <p class="lede">{ownership.lede}</p>
    </div>
    <div class="service-grid">
      {
        ownership.groups.map((group) => (
          <article class="service-card">
            <p class="service-panel">{group.summary}</p>
            <div class="service-body">
              <h3>{group.title}</h3>
              <ul class="feature-list">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <div class="service-cta">
                <Button href={site.bookingUrl} label={bookingCta} />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
