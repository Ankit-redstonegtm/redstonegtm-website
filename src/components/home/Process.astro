---
import { home } from '../../data/home';

const { process } = home;
---

<section class="section" id="how-it-works" aria-labelledby="process-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{process.eyebrow}</p>
      <h2 id="process-title">{process.title}</h2>
      <p class="lede">{process.lede}</p>
    </div>
    <ol class="steps">
      {
        process.steps.map((step, index) => (
          <li class="step">
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
