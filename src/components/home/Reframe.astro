---
import { home } from '../../data/home';

const { reframe } = home;
---

<section class="section" id="reframe" aria-labelledby="reframe-title">
  <div class="wrap reframe-layout">
    <div>
      <p class="eyebrow">{reframe.eyebrow}</p>
      <h2 id="reframe-title">{reframe.title}</h2>
    </div>
    <div>
      <p class="statement">{reframe.statement}</p>
      <div class="reframe-body">
        {reframe.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>
