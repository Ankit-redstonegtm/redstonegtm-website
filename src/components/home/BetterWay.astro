---
import { home } from '../../data/home';

const { method } = home;
---

<section class="section" id="how-it-works" aria-labelledby="method-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="method-title">{method.title}</h2>
    </div>
    <p class="context">{method.context}</p>

    <div class="method">
      <div class="method-track">
        <div class="method-line" aria-hidden="true"><span class="method-fill"></span></div>
        <ol class="method-steps">
          {
            method.steps.map((step, index) => (
              <li class="method-step" data-step={index + 1}>
                <span class="step-dot">{index + 1}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                  <div class="step-output">
                    <p class="output-label">{method.accountLabel}</p>
                    {'email' in step && step.email ? (
                      <div class="letter">
                        <p class="letter-subject">Subject: {step.email.subject}</p>
                        {step.email.paragraphs.map((paragraph) => (
                          <p>{paragraph}</p>
                        ))}
                      </div>
                    ) : (
                      <p>{'output' in step ? step.output : ''}</p>
                    )}
                    {'angles' in step && step.angles && <p class="angles">{step.angles}</p>}
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <aside class="pin" aria-hidden="true">
        <div class="live-card">
          <div class="live-top">
            <p>{method.accountName}</p>
            <ol class="dots">
              {method.steps.map((_, index) => (
                <li data-dot={index + 1} class:list={[index === 0 && 'is-on', index === 0 && 'is-current']}>
                  {index + 1}
                </li>
              ))}
            </ol>
          </div>
          <p class="output-label">{method.accountLabel}</p>
          <div class="live-body">
            {
              method.steps.map((step, index) => (
                <div class:list={['live-slice', index === 0 && 'is-current']} data-step={index + 1}>
                  {'email' in step && step.email ? (
                    <div class="letter">
                      <p class="letter-subject">Subject: {step.email.subject}</p>
                      {step.email.paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                  ) : (
                    <p>{'output' in step ? step.output : ''}</p>
                  )}
                  {'angles' in step && step.angles && <p class="angles">{step.angles}</p>}
                </div>
              ))
            }
          </div>
        </div>
      </aside>
    </div>

    <p class="close-line method-close">{method.closing}</p>

    <div class="system-block">
      <h3>{method.system.title}</h3>
      <ul class="system-grid">
        <li>
          <div class="artifact" aria-hidden="true">
            <p class="artifact-kicker">Accounts</p>
            <span><i /><em>Fit</em></span>
            <span><i /><em>Fit</em></span>
            <span class="is-new"><i /><em>New</em></span>
          </div>
          <p>{method.system.items[0]}</p>
        </li>
        <li>
          <div class="artifact artifact-signal" aria-hidden="true">
            <p class="artifact-kicker">Signal</p>
            <p class="artifact-account">{method.accountName}</p>
            <p class="artifact-alert">Expansion announced</p>
          </div>
          <p>{method.system.items[1]}</p>
        </li>
        <li>
          <div class="artifact artifact-crm" aria-hidden="true">
            <p class="artifact-kicker">CRM</p>
            <p><span>Account</span> {method.accountName}</p>
            <p><span>Contact</span> Marisol, VP of Field Sales</p>
            <p class="crm-why"><span>Why now</span> <span class="crm-value">Expansion into the Southeast</span></p>
          </div>
          <p>{method.system.items[2]}</p>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('.method');
  const pin = document.querySelector('.pin');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && pin) {
    const steps = Array.from(root.querySelectorAll<HTMLElement>('.method-step'));
    const slices = Array.from(pin.querySelectorAll<HTMLElement>('.live-slice'));
    const dots = Array.from(pin.querySelectorAll<HTMLElement>('[data-dot]'));
    const fill = root.querySelector<HTMLElement>('.method-fill');
    const line = root.querySelector<HTMLElement>('.method-line');
    const track = root.querySelector<HTMLElement>('.method-track');

    function placeLine() {
      if (!line || !track) return;
      const first = steps[0]?.querySelector('.step-dot');
      const last = steps[steps.length - 1]?.querySelector('.step-dot');
      if (!first || !last) return;
      const bounds = track.getBoundingClientRect();
      const start = first.getBoundingClientRect();
      const end = last.getBoundingClientRect();
      line.style.top = `${start.top - bounds.top + start.height / 2}px`;
      line.style.bottom = `${bounds.bottom - (end.top + end.height / 2)}px`;
    }

    function show(step: number) {
      slices.forEach((slice) => {
        slice.classList.toggle('is-current', Number(slice.dataset.step) === step);
      });
      dots.forEach((dot) => {
        const n = Number(dot.dataset.dot);
        dot.classList.toggle('is-on', n <= step);
        dot.classList.toggle('is-current', n === step);
      });
      if (fill && steps.length > 0) {
        fill.style.setProperty('--fill', String(step / steps.length));
      }
    }

    placeLine();
    show(1);
    window.addEventListener('resize', placeLine);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          const step = Number((visible.target as HTMLElement).dataset.step);
          if (step) show(step);
        },
        { rootMargin: '-35% 0px -45% 0px', threshold: [0.2, 0.6, 1] },
      );
      steps.forEach((step) => observer.observe(step));
    }
  }

  const system = document.querySelector('.system-block');
  if (system && !reduce && 'IntersectionObserver' in window) {
    system.classList.add('will-play');
    const watcher = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        system.classList.add('is-in');
        watcher.disconnect();
      },
      { threshold: 0.4 },
    );
    watcher.observe(system);
  }
</script>
