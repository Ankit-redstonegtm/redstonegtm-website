---
import { home } from '../../data/home';

const { proof } = home;
const [done, built] = proof.modes;
---

<section class="section proof" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="proof-title">{proof.title}</h2>
    </div>

    <figure class="account-brief">
      <div class="doc">
        <header class="doc-head">
          <p>{proof.brief.title}</p>
        </header>
        <dl>
          <div>
            <dt>{proof.brief.whoLabel}</dt>
            <dd>{proof.brief.who}</dd>
          </div>
          <div>
            <dt>{proof.brief.whyNowLabel}</dt>
            <dd>
              <ul class="finding-list">
                {
                  proof.brief.whyNow.map((item) => (
                    <li>
                      <span>{item.text}</span>
                      <span class="source">{item.source}</span>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
          <div>
            <dt>{proof.brief.matterLabel}</dt>
            <dd>{proof.brief.matter}</dd>
          </div>
          <div>
            <dt>{proof.brief.whoTalkLabel}</dt>
            <dd>{proof.brief.whoTalk}</dd>
          </div>
          <div>
            <dt>{proof.brief.angleLabel}</dt>
            <dd>{proof.brief.angle}</dd>
          </div>
        </dl>
        <p class="margin-note">
          <strong>{proof.brief.confidenceLabel}: </strong>
          {proof.brief.confidence}
        </p>
      </div>
    </figure>

    <h3 class="modes-title">{proof.modesTitle}</h3>
    <div class="mode-grid">
      <article class="mode-card">
        <h3>{done.title}</h3>
        <p class="mode-line">{done.line}</p>
        <p><strong>{done.forLabel}: </strong>{done.for}</p>
        <p><strong>{done.listLabel}: </strong>{done.items.join(' · ')}</p>
        <p><strong>{done.youLabel}: </strong>{done.you}</p>
      </article>
      <article class="mode-card">
        <h3>{built.title}</h3>
        <p class="mode-line">{built.line}</p>
        <p><strong>{built.forLabel}: </strong>{built.for}</p>
        <p><strong>{built.listLabel}: </strong>{built.items.join(' · ')}</p>
        <p><strong>{built.youLabel}: </strong>{built.you}</p>
        <div class="concept">
          <div class="chat" aria-label={proof.concept.prompt}>
            <p class="chat-ask">{proof.concept.prompt}</p>
            <div class="chat-answer">
              <div class="chat-line">
                <p class="list-label">{proof.concept.findingsLabel}</p>
                <ul class="finding-list">
                  {
                    proof.concept.findings.map((item) => (
                      <li>
                        <span>{item.text}</span>
                        <span class="source">{item.source}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="chat-line">
                <p class="list-label">{proof.concept.peopleLabel}</p>
                <ul class="plain-list">
                  {proof.concept.people.map((person) => <li>{person}</li>)}
                </ul>
              </div>
              <div class="chat-line">
                <p class="list-label">{proof.concept.anglesLabel}</p>
                <ul class="plain-list">
                  {proof.concept.angles.map((angle) => <li>{angle}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <div class="fit">
      <h3>{proof.fitTitle}</h3>
      <div class="fit-grid">
        <div>
          <h4>{proof.goodTitle}</h4>
          <ul class="plain-list">
            {proof.good.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h4>{proof.badTitle}</h4>
          <ul class="plain-list">
            {proof.bad.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
