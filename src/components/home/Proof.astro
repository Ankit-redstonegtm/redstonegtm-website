---
import { home } from '../../data/home';

const { proof } = home;
---

<section class="section band" id="proof" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{proof.eyebrow}</p>
      <h2 id="proof-title">{proof.title}</h2>
      <p class="lede">{proof.lede}</p>
    </div>
    <div class="proof-grid">
      {
        proof.items.map((item) => (
          <article class="proof-item">
            <p class="proof-kicker">[Proof placeholder]</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
