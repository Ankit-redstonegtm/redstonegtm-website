---
import { home } from '../data/home';
import { site } from '../data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const { follow } = home;

const cards = [
  {
    id: 'linkedin',
    title: 'LinkedIn',
    line: 'Short posts on finding the right accounts and writing outbound people reply to.',
    button: 'Follow on LinkedIn',
    href: site.linkedin,
    featured: false,
  },
  {
    id: 'youtube',
    title: 'YouTube',
    line: 'Watch me build it. Screen-share walkthroughs of real Clay tables, list cleanup and signal tracking, start to finish.',
    button: 'Watch on YouTube',
    href: site.youtube,
    featured: false,
  },
  {
    id: 'substack',
    title: 'The Insider Plays',
    line: 'One GTM play for vertical B2B in each issue: what to look for, where to find it, and the message to send.',
    button: 'Subscribe free',
    href: site.subscribeUrl,
    featured: true,
  },
] as const;
---

<ul class:list={['follow-grid', compact && 'is-compact']}>
  {
    cards.map((card) => (
      <li class:list={['follow-card', card.featured && 'is-featured']}>
        <span class="follow-mark" aria-hidden="true">
          {card.id === 'linkedin' && (
            <svg viewBox="0 0 24 24" width="28" height="28">
              <path
                fill="currentColor"
                d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8.5h4V24h-4V8.5zM8.5 8.5h3.8v2.1h.05c.53-1 1.84-2.1 3.79-2.1 4.05 0 4.8 2.67 4.8 6.14V24h-4v-7.7c0-1.84-.03-4.2-2.56-4.2-2.56 0-2.95 2-2.95 4.06V24h-4V8.5z"
              />
            </svg>
          )}
          {card.id === 'youtube' && (
            <svg viewBox="0 0 24 24" width="28" height="28">
              <path
                fill="currentColor"
                d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.75 15.5v-7l6.5 3.5-6.5 3.5z"
              />
            </svg>
          )}
          {card.id === 'substack' && (
            <svg viewBox="0 0 24 24" width="28" height="28">
              <path
                fill="currentColor"
                d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"
              />
            </svg>
          )}
        </span>
        <h3>{card.title}</h3>
        <p>{card.line}</p>
        {card.featured && (
          <p class="follow-latest">
            <a href={site.substackLatest.url} target="_blank" rel="noopener noreferrer">
              {follow.latestLabel}: {site.substackLatest.title} →
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
        )}
        <a class:list={['btn', !card.featured && 'btn-quiet']} href={card.href} target="_blank" rel="noopener noreferrer">
          {card.button}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
    ))
  }
</ul>
