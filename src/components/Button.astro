---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'small' | 'quiet' | 'inverse';
  track?: string;
  trackLocation?: string;
}

const { href, label, variant = 'primary', track, trackLocation } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  class:list={[
    'btn',
    variant === 'small' && 'btn-small',
    variant === 'quiet' && 'btn-quiet',
    variant === 'inverse' && 'btn-inverse',
  ]}
  href={href}
  data-track={track}
  data-track-location={trackLocation}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  {label}
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
