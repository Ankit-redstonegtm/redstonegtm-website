---
import Button from '../components/Button.astro';
import { primaryCta, site } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Redstone GTM" description="That page is not on Redstone GTM." robots="noindex">
  <section class="missing">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>This page is not here.</h1>
      <p class="lede">The address may be out of date. The work itself is still a conversation.</p>
      <div class="hero-actions">
        <a class="text-link" href="/">Back to the homepage</a>
        <Button href={site.bookingUrl} label={primaryCta} />
      </div>
    </div>
  </section>
</Base>
