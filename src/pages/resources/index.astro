---
import FollowCards from '../../components/FollowCards.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import Base from '../../layouts/Base.astro';
import { getResources } from '../../lib/resources';

const resources = await getResources();
const title = 'Free GTM resources | Redstone GTM';
const description =
  'Guides, templates and plays for finding companies with a reason to buy. New ones go to The Insider Plays first.';
---

<Base title={title} description={description}>
  <section class="page-intro" aria-labelledby="resources-title">
    <div class="wrap">
      <h1 id="resources-title">Free GTM resources</h1>
      <p class="lede">{description}</p>
    </div>
  </section>
  <div class="wrap resources-page">
    <div class="resource-grid">
      {resources.map((entry) => <ResourceCard entry={entry} level={2} trackLocation="resources-page" />)}
    </div>
    <FollowCards compact />
  </div>
</Base>
