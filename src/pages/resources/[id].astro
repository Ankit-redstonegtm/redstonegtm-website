---
import { render } from 'astro:content';
import SubscribeEmbed from '../../components/SubscribeEmbed.astro';
import { site } from '../../data/site';
import Base from '../../layouts/Base.astro';
import { breadcrumbJsonLd } from '../../lib/jsonld';
import { getResources } from '../../lib/resources';

export async function getStaticPaths() {
  const entries = await getResources();
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = `${entry.data.title} | Redstone GTM`;
const canonical = new URL(`/resources/${entry.id}`, site.url).href;
const crumbs = breadcrumbJsonLd([
  { name: 'Home', url: `${site.url}/` },
  { name: 'Resources', url: `${site.url}/resources` },
  { name: entry.data.title, url: canonical },
]);
const comingSoon = entry.data.status === 'coming-soon';
---

<Base title={title} description={entry.data.description} jsonLd={[crumbs]}>
  <article class="resource">
    <div class="wrap">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href="/">Home</a></li>
          <li><a href="/resources">Resources</a></li>
          <li aria-current="page">{entry.data.title}</li>
        </ol>
      </nav>
      <header class="resource-header">
        {comingSoon && <p class="soon-pill">Coming soon</p>}
        {entry.data.format && <p class="format-label">{entry.data.format}</p>}
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
      </header>
      <div class="resource-body">
        {
          entry.data.bullets.length > 0 && (
            <ul class="resource-points">
              {entry.data.bullets.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        }
        {
          comingSoon && (
            <SubscribeEmbed line="Get it first. It goes to subscribers before anyone else." resource={entry.id} />
          )
        }
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>
